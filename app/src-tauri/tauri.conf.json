{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Micro Speed Grader",
  "version": "0.2.3",
  "identifier": "edu.rice.microspeedgrader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Micro Speed Grader",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMjQxRTg3RDQxMUU2RTYKUldUbTVoSFVoeDRra2xLWjRBSHpSeVA2bW1scVFCeUo2dWl4bFlVR1RpdHB3QnpoVWdvU3gyQ04K",
      "endpoints": [
        "https://github.com/agadin/micro-speed-grader/releases/latest/download/latest.json"
      ]
    }
  }
}